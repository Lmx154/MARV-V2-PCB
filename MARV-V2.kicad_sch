(kicad_sch (version 20250114) (generator "eeschema") (uuid 951d7307-88ce-5bfb-b9e0-55612ee5a02b) (paper "A3") (title_block (title "MARV integrated power - preliminary") (date "2026-09-14") (rev "P0 - NOT FOR FAB")) (lib_symbols)
(text "Integrated draft: power chain (sheets 2-4) and board stage (sheets 5-8). See DESIGN_SPEC.md.\nInputs: VBAT 6-25.2 V (2-6S) from the MicoAir AM32 ESC pad row J3, and USB VBUS.\nRails: 5V_IN from the U26 AP63205 buck, V5_SYS from the U25 TPS2121 mux, V3V3_SYS from the\nTPS62913 buck, V3V3_ANA from the TPS7A20 LDO. Servo 5 V is 5V_IN, upstream of the mux.\nNo PCB placement or routing has been performed." (at 20 20 0) (effects (font (size 1.8 1.8)) (justify left top)) (uuid 8970ceb1-2e33-51d9-bcd1-fef8ea4ab958))
