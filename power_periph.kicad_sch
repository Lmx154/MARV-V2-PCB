(symbol (lib_id "Connector_Generic:Conn_01x14") (at 279.4 129.54 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid 21a5ebad-f429-5c63-837a-215e3ae846ba) (property "Reference" "J8" (at 266 100 0) (effects (font (size 1 1)) (justify left) )) (property "Value" "IO array GND column (board edge)" (at 266 102.54 0) (effects (font (size 1 1)) (justify left) )) (property "Footprint" "MARV_Packages:PinHeader_1x14_P2.54mm_Vertical_IORow" (at 279.4 129.54 0) (effects (font (size 1 1)) (justify left) (hide yes))) (property "Datasheet" "" (at 279.4 129.54 0) (effects (font (size 1 1)) (justify left) (hide yes))) (pin "1" (uuid 5e07d009-d3b7-54b7-a888-06e14a955df6)) (pin "2" (uuid a0c9dc7f-0e63-5949-8f3c-9651d284ab77)) (pin "3" (uuid f57f9ca8-cdb7-5051-a6e4-0abbcb7c8751)) (pin "4" (uuid 15396185-891a-5dcd-b2e4-129a08ef1254)) (pin "5" (uuid efbc61a1-3479-54c4-a0d7-225df8c2dee9)) (pin "6" (uuid dabdcd7f-696c-5b21-983d-e456a0b9c817)) (pin "7" (uuid dbda4f13-a83e-5701-893d-32d333b4d4ac)) (pin "8" (uuid 82928846-5766-5c9f-9921-318770e9c5de)) (pin "9" (uuid 00f53634-70b6-5da0-be22-16eff4be7781)) (pin "10" (uuid 73bbb296-afa2-5f62-a9ae-88a44a10e74a)) (pin "11" (uuid a54af7b6-108c-54c2-bd92-e84a0d2a6f94)) (pin "12" (uuid 7e9c60dd-410b-5ad2-91ed-10691700a64c)) (pin "13" (uuid 78e8f77a-d4a6-54b5-9136-b3b2433d6dae)) (pin "14" (uuid 376a52db-4e0b-50a9-99f2-1c17c1060bd2)) (instances (project "MARV-V2" (path "/951d7307-88ce-5bfb-b9e0-55612ee5a02b/a37f6ba3-6a13-5152-99c8-874772176748" (reference "J8") (unit 1)))))
(text "IO ARRAY ROW MAP (row n = J6 pin n signal | J7 pin n power | J8 pin n GND)\n 1  T0   GPS_RX      | V5_SYS    | GND  UART0 TX -> GPS RX (GPIO12)\n 2  R0   GPS_TX      | V5_SYS    | GND  UART0 RX <- GPS TX (GPIO13)\n 3  T1   ELRS_RX     | V5_SYS    | GND  UART1 TX -> ELRS RX (GPIO8)\n 4  R1   ELRS_TX     | V5_SYS    | GND  UART1 RX <- ELRS TX (GPIO9)\n 5  SDA  MAG_SDA     | V3V3_SYS  | GND  I2C1 SDA (GPIO6), 4.7k pull-up on the MCU sheet\n 6  SCL  MAG_SCL     | V3V3_SYS  | GND  I2C1 SCL (GPIO7), 4.7k pull-up on the MCU sheet\n 7  S5   PWM5        | V5_SYS    | GND  PWM5 A (GPIO10), servo 5\n 8  S6   PWM6        | V5_SYS    | GND  PWM5 B (GPIO11), servo 6\n 9  S7   PWM7        | V5_SYS    | GND  PWM7 A (GPIO14), servo 7\n10  S8   PWM8        | V5_SYS    | GND  PWM7 B (GPIO15), servo 8\n11  A44  IO_GPIO44   | V3V3_SYS  | GND  GPIO44 = ADC4, spare\n12  A45  IO_GPIO45   | V3V3_SYS  | GND  GPIO45 = ADC5, spare\n13  A46  IO_GPIO46   | V3V3_SYS  | GND  GPIO46 = ADC6, spare\n14  A47  IO_GPIO47   | V3V3_SYS  | GND  GPIO47 = ADC7, spare" (at 15 150 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid 235ceeb1-5bc3-5da8-beb9-7396ab18bca0))
(text "RAILS ON THE ARRAY: rows 1-4 (GPS, ELRS) and rows 7-10 (servos S5-S8) take V5_SYS; rows 5-6 (magnetometer)\nand rows 11-14 (the four exposed spares) take V3V3_SYS. Every row has its own GND pin in the J8 column, so a\nsignal return is never more than 2.54 mm away and no row can be mis-plugged into a neighbour's ground.\nSERVO 5 V NOW COMES FROM V5_SYS, NOT 5V_IN. The old J13 servo row tapped 5V_IN directly at the U26 buck\noutput, ahead of the U25 priority mux, so servo current was outside the mux current limit. With one power\ncolumn the array cannot carry two different 5 V nets under one \"5V\" silk label, so all eight 5 V rows are\nV5_SYS: servo current now crosses U25 and counts against its ILM limit (1.49 A, R46) and against the U26\nbuck. Budget servo current against BOTH - see DESIGN_SPEC \"Rails and load budget\".\nCURRENT: rows 1-4 and 7-10 count against the U26 buck through the mux; rows 5-6 and 11-14 count in the\nV3V3_SYS budget. No fuse and no per-row current limit: the array is a system-integration connector, not a\nprotected port." (at 15 215 0) (effects (font (size 1.35 1.35)) (justify left top)) (uuid 5b5f65b9-e052-57a0-99cc-12fdaea0424d))
(text "PWM MAP\nPWM5 = GPIO10 (row 7, S5)\nPWM6 = GPIO11 (row 8, S6)\nPWM7 = GPIO14 (row 9, S7)\nPWM8 = GPIO15 (row 10, S8)\n\nON THE ESC PAD ROW (J3, POWER 1)\nPWM1 = GPIO2\nPWM2 = GPIO3\nPWM3 = GPIO4\nPWM4 = GPIO5" (at 330 150 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid eba410cd-7182-50ec-9ad6-a84cc44daf66))
(embedded_fonts no))
