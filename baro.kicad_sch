	)
	(text "U22 BMP581: SCK/SCL = BARO_SCL; SDI/SDA = BARO_SDA; INT = BARO_INT (dedicated GPIO13).\nCSB is hard-wired to VDDIO / V3V3_ANA for I2C mode. SDO/ADDR is tied to GND: 7-bit address 0x46.\nR50 and R57 are 4.7k pull-ups to V3V3_ANA on SCL and SDA; no pull-downs.\nVDDIO and VDD use V3V3_ANA; all VSS pins use GND. C54/C56 remain 100 nF per supply pin."
		(exclude_from_sim no)
		(at 10 150 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "5c9384ab-393d-5a12-b26a-b19028ef9b5b")
	)
