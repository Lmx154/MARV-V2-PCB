	(text "POWER 3 - U7 AP63203WU-7 FIXED 3.3 V BUCK (V5_SYS -> V3V3_SYS) AND U12 TPS7A20 LDO (-> V3V3_ANA)\nAVIONICS ONLY: 300 mA continuous / 500 mA short peak, provisional. NO SERVO POWER."
		(exclude_from_sim no)
		(at 10 7 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "2ac5bde1-9fea-59d8-8348-2fd6057112fc")
	)
